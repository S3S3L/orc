{
  "version": "1.0",
  "name": "简单流水线测试",
  "description": "验证顺序执行和条件分支功能",
  "nodes": [
    {
      "id": "init",
      "type": "bash",
      "name": "初始化",
      "config": {
        "script": "scripts/init.sh",
        "argsPassing": { "type": "stdin" }
      }
    },
    {
      "id": "process",
      "type": "bash",
      "name": "处理",
      "config": {
        "script": "scripts/process.sh",
        "argsPassing": { "type": "stdin" }
      }
    },
    {
      "id": "success",
      "type": "bash",
      "name": "成功路径",
      "config": {
        "script": "scripts/success.sh",
        "argsPassing": { "type": "stdin" }
      }
    },
    {
      "id": "failure",
      "type": "bash",
      "name": "失败路径",
      "config": {
        "script": "scripts/failure.sh",
        "argsPassing": { "type": "stdin" }
      }
    },
    {
      "id": "final",
      "type": "bash",
      "name": "最终汇总",
      "config": {
        "script": "scripts/final.sh",
        "argsPassing": { "type": "stdin" }
      }
    }
  ],
  "edges": [
    {
      "id": "edge-init-to-process",
      "from": { "nodeId": "init" },
      "to": { "nodeId": "process", "input": "config" }
    },
    {
      "id": "edge-process-branch",
      "from": { "nodeId": "process" },
      "condition": {
        "branches": [
          {
            "expression": "outputs.process.status == 'success'",
            "to": { "nodeId": "success", "input": "data" }
          },
          {
            "expression": "outputs.process.status == 'failure'",
            "to": { "nodeId": "failure", "input": "data" }
          }
        ],
        "onNoMatch": "skip"
      }
    },
    {
      "id": "edge-success-to-final",
      "from": { "nodeId": "success" },
      "to": { "nodeId": "final", "input": "result" }
    },
    {
      "id": "edge-failure-to-final",
      "from": { "nodeId": "failure" },
      "to": { "nodeId": "final", "input": "result" }
    }
  ]
}
